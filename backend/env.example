# Copy this file to .env for local dev and fill in real values.
# On Railway, set these under Variables instead — do not upload .env itself.

# Required — from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Recommended — shared secret between backend and widget.html.
# Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
WIDGET_SHARED_SECRET=

# Your real website URL (sent to OpenRouter as the HTTP-Referer header)
SITE_URL=https://bizadvise.com

# Comma-separated list of domains allowed to call /chat.
# Leave unset locally; set to your real domain(s) before going live.
ALLOWED_ORIGINS=https://bizadvise.com,https://www.bizadvise.com
